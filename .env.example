# ───────────────────────────────────────────────────────────────────────────
# Frontend secrets — must be prefixed with VITE_ so Vite injects them into
# the browser bundle. These are PUBLIC by the time the app ships — restrict
# them via referer / origin policy on the provider side.
# ───────────────────────────────────────────────────────────────────────────

# Required: Google Gemini API key for the AI features.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: Smithsonian Open Access API key (Library panel scraper adapter).
# Get one at https://api.data.gov/signup/
VITE_SMITHSONIAN_API_KEY=""

# Optional: Where this applet is hosted. AI Studio injects it at runtime;
# leave blank for local dev to fall back to window.location.origin.
APP_URL=""

# ───────────────────────────────────────────────────────────────────────────
# Backend secrets — NEVER prefix with VITE_. Set via the Cloudflare Pages
# dashboard ("Settings → Environment variables → Secrets") OR locally with:
#   npx wrangler pages secret put GOOGLE_CLIENT_ID
# For local dev with `npm run dev:full`, drop them in `.dev.vars` (gitignored).
# ───────────────────────────────────────────────────────────────────────────

# Google OAuth 2.0 client credentials (used by /api/auth/login + /api/auth/callback).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# JWT signing secret. Must be ≥ 32 bytes of entropy.
# Generate one with: openssl rand -base64 48
JWT_SECRET=""
